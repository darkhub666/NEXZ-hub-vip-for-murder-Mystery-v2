local function makeToggle(text, order, default, cb)
	local f = Instance.new("TextButton")
	f.Size = UDim2.new(1, -24, 0, 36)
	f.BackgroundColor3 = DARK
	f.Text = ""
	f.AutoButtonColor = false
	f.LayoutOrder = order
	f.Parent = panel
	corner(f, 8)
	local l = Instance.new("TextLabel")
	l.Size = UDim2.new(1, -70, 1, 0)
	l.Position = UDim2.fromOffset(10, 0)
	l.BackgroundTransparency = 1
	l.Text = text
	l.TextColor3 = Color3.new(1, 1, 1)
	l.Font = Enum.Font.Gotham
	l.TextSize = 13
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.Parent = f
	local st = Instance.new("TextLabel")
	st.Size = UDim2.fromOffset(46, 22)
	st.Position = UDim2.new(1, -54, 0.5, -11)
	st.Font = Enum.Font.GothamBold
	st.TextSize = 12
	st.Parent = f
	corner(st, 6)
	local on = default
	local function paint()
		st.Text = on and "ON" or "OFF"
		st.BackgroundColor3 = on and PURPLE or BLACK
		st.TextColor3 = on and Color3.new(1, 1, 1) or Color3.fromRGB(140, 140, 140)
	end
	paint()
	f.MouseButton1Click:Connect(function() on = not on paint() cb(on) end)
end

