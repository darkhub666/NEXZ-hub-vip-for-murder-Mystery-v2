-- ===== helpers =====
local function getTool(plr: Player, name: string): Tool?
	local char, bp = plr.Character, plr:FindFirstChildOfClass("Backpack")
	return (char and char:FindFirstChild(name)) or (bp and bp:FindFirstChild(name)) or nil
end

local function getRole(plr: Player): string?
	if getTool(plr, "Knife") then return "murder" end
	if getTool(plr, "Gun") then return "sheriff" end
	return nil
end

local function findPlayerByRole(role: string): Player?
	for _, p in ipairs(Players:GetPlayers()) do
		if getRole(p) == role then return p end
	end
	return nil
end

local function root(plr: Player): BasePart?
	return plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
end

local function alive(plr: Player): boolean
	local h = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
	return h ~= nil and h.Health > 0
end

local function getGunDrop(): BasePart?
	local d = Workspace:FindFirstChild("GunDrop", true)
	if d and d:IsA("BasePart") then return d end
	return nil
end

local function touch(a: BasePart, b: BasePart)
	pcall(function() firetouchinterest(a, b, 0) firetouchinterest(a, b, 1) end)
end

-- ===== ESP =====
local function setHighlight(plr: Player, color: Color3?)
	local h = highlights[plr]
	if not color or not plr.Character then
		if h then h:Destroy() highlights[plr] = nil end
		return
	end
	if not h or h.Parent ~= plr.Character then
		if h then h:Destroy() end
		h = Instance.new("Highlight")
		h.FillTransparency = 0.5
		h.OutlineColor = Color3.new(1, 1, 1)
		h.Parent = plr.Character
		highlights[plr] = h
	end
	h.FillColor = color
end

local roleLabel
local function updateESP()
	local m, s = findPlayerByRole("murder"), findPlayerByRole("sheriff")
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LP then
			if not alive(p) then setHighlight(p, nil)
			elseif state.espRoles and p == m then setHighlight(p, Color3.fromRGB(255, 40, 40))
			elseif state.espRoles and p == s then setHighlight(p, Color3.fromRGB(60, 120, 255))
			elseif state.espInnocent and p ~= m and p ~= s then setHighlight(p, Color3.fromRGB(60, 255, 120))
			else setHighlight(p, nil) end
		end
	end
	if roleLabel then
		roleLabel.Text = "Murder: " .. (m and m.DisplayName or "?") .. "\nSheriff: " .. (s and s.DisplayName or "?")
	end
end

-- ===== auto gun =====
local busy = false
local function grabGun()
	if busy then return end
	local drop, r = getGunDrop(), root(LP)
	if not drop or not r then return end
	busy = true
	local back = r.CFrame
	r.CFrame = drop.CFrame + Vector3.new(0, 2, 0)
	task.wait(0.15)
	touch(r, drop)
	task.wait(0.25)
	if not state.autoKill then r.CFrame = back end
	busy = false
end

-- ===== auto kill murder (com a arma) =====
local lastShot = 0
local function shootMurder()
	if tick() - lastShot < 0.9 then return end
	local char = LP.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local r = root(LP)
	local gun = getTool(LP, "Gun")
	local m = findPlayerByRole("murder")
	local mr = m and root(m)
	if not (hum and r and gun and mr and m ~= LP and alive(m)) then return end
	if gun.Parent ~= char then hum:EquipTool(gun) task.wait(0.15) end
	lastShot = tick()
	r.CFrame = mr.CFrame * CFrame.new(0, 0, 7)
	task.wait(0.08)
	local aim = mr.Position + (mr.AssemblyLinearVelocity * 0.1)
	local fired = pcall(function()
		gun.Shoot:FireServer(CFrame.new(r.Position), CFrame.new(aim))
	end)
	if not fired then
		fired = pcall(function()
			gun.KnifeLocal.CreateBeam.RemoteFunction:InvokeServer(1, aim, "AH2")
		end)
	end
	if not fired then pcall(function() gun:Activate() end) end
end

-- ===== kill all (como murder) =====
local function killAllRound()
	local char = LP.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local r = root(LP)
	local knife = getTool(LP, "Knife")
	if not (hum and r and knife) then return end
	if knife.Parent ~= char then hum:EquipTool(knife) task.wait(0.15) end
	for _, p in ipairs(Players:GetPlayers()) do
		if not state.killAll then break end
		local tr = root(p)
		if p ~= LP and tr and alive(p) then
			r.CFrame = tr.CFrame * CFrame.new(0, 0, 2)
			task.wait(0.05)
			pcall(function() knife.Stab:FireServer("Slash") end)
			local handle = knife:FindFirstChild("Handle")
			if handle then touch(handle, tr) end
			pcall(function() knife:Activate() end)
			task.wait(0.12)
		end
	end
end

-- ===== moedas =====
local function bagFull(): boolean
	local ok, res = pcall(function()
		return LP.PlayerGui.MainGUI.Game.CoinBags.Container.Coin.FullBagIcon.Visible
	end)
	return ok and res == true
end

local function getCoins(): { Instance }
	for _, m in ipairs(Workspace:GetChildren()) do
		local c = m:FindFirstChild("CoinContainer")
		if c then return c:GetChildren() end
	end
	return {}
end

