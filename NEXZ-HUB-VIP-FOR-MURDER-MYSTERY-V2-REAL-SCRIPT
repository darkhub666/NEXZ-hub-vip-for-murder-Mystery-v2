-- ===== loops =====
task.spawn(function()
	while task.wait(0.3) do
		if not gui or not gui.Parent then break end
		pcall(updateESP)
		if state.autoGun and getGunDrop() then pcall(grabGun) end
		if state.autoKill then pcall(shootMurder) end
	end
end)

task.spawn(function()
	local seen = {}
	while task.wait(0.05) do
		if not gui or not gui.Parent then break end
		if state.coins then
			if bagFull() then
				if infoLabel then infoLabel.Text = "Saco cheio" end
			else
				if infoLabel then infoLabel.Text = "Coletando moedas..." end
				local r = root(LP)
				if r then
					local best, bd
					for _, c in ipairs(getCoins()) do
						if c:IsA("BasePart") and c.Name == "Coin_Server" and (not seen[c] or tick() - seen[c] > 1.5) then
							local d = (c.Position - r.Position).Magnitude
							if not bd or d < bd then best, bd = c, d end
						end
					end
					if best then
						seen[best] = tick()
						r.CFrame = best.CFrame
						touch(r, best)
					end
				end
			end
		end
	end
end)

task.spawn(function()
	while task.wait(0.1) do
		if not gui or not gui.Parent then break end
		if state.killAll then pcall(killAllRound) end
	end
end)

